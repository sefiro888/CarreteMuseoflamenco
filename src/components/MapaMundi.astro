<style>
  .worldmap {
    margin: 0;
    background: color-mix(in srgb, var(--color-charcoal) 70%, var(--color-black-warm));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-sm) var(--space-2xs);
    overflow: hidden;
  }

  .worldmap svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .worldmap__land {
    fill: color-mix(in srgb, var(--color-paper) 12%, transparent);
    stroke: color-mix(in srgb, var(--color-paper) 20%, transparent);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .worldmap__dot {
    fill: var(--color-accent);
  }

  .worldmap__dot--home {
    fill: var(--color-wine);
    stroke: var(--color-accent);
    stroke-width: 2.5;
  }

  .worldmap__halo {
    fill: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .worldmap__halo--home {
    fill: color-mix(in srgb, var(--color-wine) 30%, transparent);
    transform-origin: center;
    transform-box: fill-box;
    animation: latido 3.4s ease-in-out infinite;
  }

  /* Torremolinos late despacio: es la casa desde la que sale todo lo demás. */
  @keyframes latido {
    0%, 100% { opacity: 0.45; r: 20; }
    50% { opacity: 0.9; r: 26; }
  }

  @media (prefers-reduced-motion: reduce) {
    .worldmap__halo--home {
      animation: none;
    }
  }

  .worldmap figcaption {
    margin-top: var(--space-2xs);
    text-align: center;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
</style>
