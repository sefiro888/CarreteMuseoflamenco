---
import { getEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  sourceRefs: { collection: 'sources'; id: string }[];
  locale?: Locale;
}

const { sourceRefs, locale = 'es' } = Astro.props;
const dict = t(locale);
const sources = await Promise.all(sourceRefs.map((ref) => getEntry(ref)));
const resolved = sources.filter((s): s is NonNullable<typeof s> => Boolean(s));
---

{
  resolved.length > 0 && (
    <div class="source-list">
      <h4 class="source-list__heading">{dict.sources}</h4>
      <ul>
        {resolved.map((source) => (
          <li>
            {source.data.url ? (
              <a href={source.data.url} target="_blank" rel="noopener noreferrer">
                {source.data.title}
              </a>
            ) : (
              <span>{source.data.title}</span>
            )}
            {source.data.authors.length > 0 && <span> — {source.data.authors.join(', ')}</span>}
            {source.data.year && <span> ({source.data.year})</span>}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .source-list {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px dashed var(--color-border);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  .source-list__heading {
    font-family: var(--font-body);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-2xs);
  }
  .source-list ul {
    margin: 0;
    padding-left: 1.1em;
  }
  .source-list li {
    margin-bottom: var(--space-3xs);
  }
</style>
