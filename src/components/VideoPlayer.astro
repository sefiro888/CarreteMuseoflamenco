---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster: ImageMetadata;
  /** Descripción de lo que se ve, para quien no pueda reproducir el vídeo. */
  description: string;
  credit?: string;
  durationSeconds?: number;
}

const { src, poster, description, credit, durationSeconds } = Astro.props;

const posterImg = await getImage({ src: poster, width: 1280, format: 'webp', quality: 78 });

const minutes = durationSeconds ? Math.floor(durationSeconds / 60) : null;
const seconds = durationSeconds ? durationSeconds % 60 : null;
const durationLabel =
  minutes !== null && seconds !== null
    ? `${minutes}:${String(seconds).padStart(2, '0')}`
    : null;
---

<figure class="video">
  <!-- Sin autoplay y sin precarga: el vídeo solo se descarga si se pide. -->
  <video controls preload="none" poster={posterImg.src} playsinline>
    <source src={src} type="video/mp4" />
    <p>
      Tu navegador no puede reproducir este vídeo.
      <a href={src} download>Descargar el archivo</a>.
    </p>
  </video>

  <figcaption>
    <p class="video__description">{description}</p>
    <p class="video__meta">
      {durationLabel && <span>{durationLabel}</span>}
      {credit && <span>{credit}</span>}
    </p>
  </figcaption>
</figure>

<style>
  .video {
    margin: 0;
  }

  .video video {
    width: 100%;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-charcoal) 80%, black);
    display: block;
  }

  .video figcaption {
    margin-top: var(--space-xs);
  }

  .video__description {
    margin: 0;
    color: var(--color-text-soft);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }

  .video__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: var(--space-3xs) 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-paper) 45%, transparent);
  }
</style>
