---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Vídeo alojado en YouTube o Vimeo, incrustado solo cuando se pide.
 *
 * Al cargar la página no se contacta con la plataforma: se muestra la miniatura
 * que el museo guarda en su propio archivo. El iframe se inserta al pulsar, y
 * con el dominio sin cookies de YouTube. Coherente con la promesa de la portada:
 * aquí no suena nada si no lo pides.
 */
interface Props {
  platform: 'youtube' | 'vimeo';
  videoId: string;
  title: string;
  poster: ImageMetadata;
  description?: string;
  credit?: string;
  durationSeconds?: number;
  /** El primero de una página carga su miniatura sin diferir. */
  eager?: boolean;
}

const { platform, videoId, title, poster, description, credit, durationSeconds, eager = false } =
  Astro.props;

const posterImg = await getImage({ src: poster, width: 1280, format: 'webp', quality: 76 });

const embedSrc =
  platform === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`
    : `https://player.vimeo.com/video/${videoId}?autoplay=1`;

const watchUrl =
  platform === 'youtube'
    ? `https://www.youtube.com/watch?v=${videoId}`
    : `https://vimeo.com/${videoId}`;

const mins = durationSeconds ? Math.floor(durationSeconds / 60) : null;
const secs = durationSeconds ? durationSeconds % 60 : null;
const duration = mins !== null && secs !== null ? `${mins}:${String(secs).padStart(2, '0')}` : null;
---

<figure class="embed">
  <div class="embed__frame" data-embed data-src={embedSrc} data-title={title}>
    <button class="embed__play" type="button" aria-label={`Reproducir: ${title}`}>
      <img
        src={posterImg.src}
        alt=""
        width="1280"
        height="720"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span class="embed__icon" aria-hidden="true">
        <svg viewBox="0 0 68 48" width="68" height="48">
          <path
            class="embed__icon-bg"
            d="M66.5 7.7c-.8-2.9-2.5-5.4-5.4-6.2C55.8.1 34 0 34 0S12.2.1 6.9 1.5C4 2.3 2.3 4.8 1.5 7.7 0 13 0 24 0 24s0 11 1.5 16.3c.8 2.9 2.5 5.4 5.4 6.2C12.2 47.9 34 48 34 48s21.8-.1 27.1-1.5c2.9-.8 4.6-3.3 5.4-6.2C68 35 68 24 68 24s0-11-1.5-16.3z"
          ></path>
          <path class="embed__icon-arrow" d="M45 24 27 14v20"></path>
        </svg>
      </span>
      {duration && <span class="embed__duration">{duration}</span>}
    </button>
  </div>

  <figcaption class="embed__caption">
    {description && <p class="embed__description">{description}</p>}
    <p class="embed__meta">
      {credit && <span>{credit}</span>}
      <a href={watchUrl} target="_blank" rel="noopener noreferrer">
        Ver en {platform === 'youtube' ? 'YouTube' : 'Vimeo'} ↗
      </a>
    </p>
  </figcaption>
</figure>

<script>
  // Se sustituye la miniatura por el iframe solo al pulsar.
  document.querySelectorAll('[data-embed]').forEach((frame) => {
    const button = frame.querySelector('button');
    button?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = frame.getAttribute('data-src') ?? '';
      iframe.title = frame.getAttribute('data-title') ?? 'Vídeo';
      iframe.loading = 'lazy';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    });
  });
</script>

<style>
  .embed {
    margin: 0;
  }

  .embed__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-charcoal);
    box-shadow: var(--shadow-card);
  }

  .embed__frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .embed__play {
    all: unset;
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .embed__play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-standard),
      filter var(--duration-base) var(--ease-standard);
  }

  .embed__play:hover img,
  .embed__play:focus-visible img {
    transform: scale(1.03);
    filter: brightness(1.08);
  }

  .embed__play:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -4px;
  }

  .embed__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .embed__icon-bg {
    fill: rgba(23, 19, 16, 0.72);
    transition: fill var(--duration-base) var(--ease-standard);
  }

  .embed__play:hover .embed__icon-bg,
  .embed__play:focus-visible .embed__icon-bg {
    fill: var(--color-wine);
  }

  .embed__icon-arrow {
    fill: var(--color-ivory);
  }

  .embed__duration {
    position: absolute;
    right: var(--space-2xs);
    bottom: var(--space-2xs);
    background: rgba(23, 19, 16, 0.82);
    color: var(--color-ivory);
    font-size: var(--step--1);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
  }

  .embed__caption {
    margin-top: var(--space-2xs);
  }

  .embed__description {
    color: var(--color-text-soft);
    margin: 0 0 var(--space-3xs);
  }

  .embed__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
