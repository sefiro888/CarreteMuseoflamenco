---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import { t, localizedPath, type Locale } from '../lib/i18n';
import heroImage from '../assets/archivo/2022-05-21-aitor-lara.jpg';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const dict = t(locale);

const heroAlt =
  locale === 'es'
    ? 'Carrete de Málaga, de pie en el centro de una calle estrecha, con sombrero, chaqueta clara y bastón levantado. Fotografía en blanco y negro de Aitor Lara, 2022.'
    : 'Carrete de Málaga standing in the middle of a narrow street, wearing a hat and light jacket and raising his cane. Black and white photograph by Aitor Lara, 2022.';
---

<section class="hero" aria-label={locale === 'es' ? 'Apertura del museo' : 'Museum opening'}>
  <div class="hero__media">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content container">
    <p class="hero__kicker">{locale === 'es' ? 'Museo digital de José Losada Santiago' : 'Digital museum of José Losada Santiago'}</p>
    <h1 class="hero__name">{dict.siteName}</h1>
    <p class="hero__tagline">{dict.tagline}</p>

    <div class="hero__lines">
      <p>{locale === 'es' ? 'Una vida bailada.' : 'A life danced.'}</p>
      <p>
        {
          locale === 'es'
            ? 'De las espigas de trigo a los grandes escenarios.'
            : 'From the ears of wheat to the great stages.'
        }
      </p>
    </div>

    <div class="hero__steps" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="hero__actions">
      <a class="btn btn-primary" href={localizedPath('/vida/yo-no-se-la-eda-que-tengo', locale)}>
        {dict.enterMuseum}
      </a>
      <button class="btn hero__audio-btn" id="hero-audio-toggle" type="button" aria-pressed="false">
        {dict.listenToCarrete}
      </button>
    </div>

    <p class="hero__audio-status" id="hero-audio-status" role="status" aria-live="polite"></p>

    <p class="hero__note">
      {
        locale === 'es'
          ? 'Veintisiete segundos de su voz, del archivo familiar. Aquí no suena nada si no lo pides.'
          : "Twenty-seven seconds of his voice, from the family archive. Nothing plays here unless you ask for it."
      }
    </p>
  </div>

  <p class="hero__credit">Fotografía: Aitor Lara, 2022</p>
</section>

<audio id="hero-audio" preload="none">
  <source src={url("/audio/carrete-intro.mp3")} type="audio/mpeg" />
</audio>

<script define:vars={{ es: locale === 'es' }}>
  const button = document.getElementById('hero-audio-toggle');
  const audio = document.getElementById('hero-audio');
  const status = document.getElementById('hero-audio-status');

  const messages = es
    ? {
        pending: 'El audio de Carrete está pendiente de incorporación por la familia. Vuelve pronto.',
        playing: 'Reproduciendo la voz de Carrete.',
        paused: 'Audio pausado.',
      }
    : {
        pending: "Carrete's audio is pending upload by the family. Check back soon.",
        playing: "Playing Carrete's voice.",
        paused: 'Audio paused.',
      };

  audio?.addEventListener('error', () => {
    button?.setAttribute('aria-pressed', 'false');
    if (status) status.textContent = messages.pending;
  });

  button?.addEventListener('click', async () => {
    if (!audio || !(audio instanceof HTMLAudioElement)) return;

    if (!audio.paused) {
      audio.pause();
      button.setAttribute('aria-pressed', 'false');
      if (status) status.textContent = messages.paused;
      return;
    }

    if (audio.error || audio.networkState === audio.NETWORK_NO_SOURCE) {
      if (status) status.textContent = messages.pending;
      return;
    }

    const safetyTimeout = window.setTimeout(() => {
      if (audio.readyState === 0 || audio.error) {
        audio.pause();
        button.setAttribute('aria-pressed', 'false');
        if (status) status.textContent = messages.pending;
      }
    }, 2500);

    try {
      await audio.play();
      window.clearTimeout(safetyTimeout);
      if (audio.readyState === 0) {
        button.setAttribute('aria-pressed', 'false');
        if (status) status.textContent = messages.pending;
      } else {
        button.setAttribute('aria-pressed', 'true');
        if (status) status.textContent = messages.playing;
      }
    } catch {
      window.clearTimeout(safetyTimeout);
      if (status) status.textContent = messages.pending;
    }
  });
</script>

<style>
  /* La fotografía de portada es apaisada y con la figura centrada: si el texto
     se superpone, le tapa la cara. Se compone en dos bandas —imagen arriba,
     palabra abajo— unidas por un degradado, para que la foto se lea entera. */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto auto;
    overflow: hidden;
    background: var(--color-black-warm);
    padding-bottom: var(--space-lg);
  }

  .hero__media {
    position: relative;
    /* Sin altura propia: la banda de imagen ocupa lo que sobra de la pantalla
       una vez colocado el texto, y nunca lo desplaza fuera del primer golpe
       de vista. */
    min-height: 40svh;
    overflow: hidden;
  }

  .hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Sube el encuadre para que la figura quede por encima del bloque de
       texto en vez de quedar tapada por él. */
    object-position: center 30%;
    /* La foto es de por sí en blanco y negro; el filtro solo la asienta
       sobre el negro cálido del museo. */
    filter: contrast(1.04) brightness(0.9);
  }

  /* Funde el pie de la fotografía con el negro del museo, para que la banda
     de texto no parezca una caja pegada debajo. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-black-warm) 0%,
      color-mix(in srgb, var(--color-black-warm) 70%, transparent) 14%,
      transparent 34%,
      transparent 82%,
      color-mix(in srgb, var(--color-black-warm) 60%, transparent) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
    padding-top: var(--space-sm);
    animation: hero-rise var(--duration-slow) var(--ease-standard) both;
  }

  .hero__credit {
    grid-row: 3;
    margin: var(--space-sm) 0 0;
    padding-inline: var(--space-md);
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-paper) 50%, transparent);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__kicker {
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xs);
  }

  .hero__name {
    font-size: var(--step-5);
    margin-bottom: var(--space-3xs);
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .hero__lines {
    font-size: var(--step-1);
    color: var(--color-paper);
    margin-bottom: var(--space-sm);
    line-height: var(--leading-snug);
  }

  .hero__lines p {
    margin: 0;
  }

  .hero__steps {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .hero__steps span {
    width: 0.4rem;
    height: 1.4rem;
    background: var(--color-bronze);
    border-radius: 999px;
    animation: hero-step 1.6s var(--ease-standard) infinite;
  }

  .hero__steps span:nth-child(2) {
    animation-delay: 0.12s;
  }
  .hero__steps span:nth-child(3) {
    animation-delay: 0.24s;
  }
  .hero__steps span:nth-child(4) {
    animation-delay: 0.36s;
  }
  .hero__steps span:nth-child(5) {
    animation-delay: 0.48s;
  }

  @keyframes hero-step {
    0%,
    100% {
      transform: scaleY(0.5);
      opacity: 0.5;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content {
      animation: none;
    }
    .hero__steps span {
      animation: none;
      transform: scaleY(0.8);
      opacity: 0.8;
    }
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .hero__audio-status {
    min-height: 1.4em;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .hero__note {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-inline: auto;
  }
</style>
