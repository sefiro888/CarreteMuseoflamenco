---
import { getCollection } from 'astro:content';

/**
 * La vida entera en una barra.
 *
 * La lista de abajo cuenta los hitos uno a uno; esto sirve para verlos todos a
 * la vez y entender el ritmo: dieciséis años apretados al principio, un salto
 * enorme entre 1969 y 2005 —los años en los que nadie lo llamaba— y luego todo
 * junto al final.
 *
 * Cada marca lleva al hito correspondiente de la lista.
 */
const hitos = (await getCollection('timeline'))
  .filter((h) => typeof h.data.year === 'number')
  .sort((a, b) => a.data.order - b.data.order);

const anios = hitos.map((h) => h.data.year as number);
const INICIO = Math.min(...anios);
const FIN = Math.max(...anios);
const pos = (a: number) => ((a - INICIO) / (FIN - INICIO)) * 100;

/** Décadas rotuladas bajo el eje. */
const decadas: number[] = [];
for (let d = Math.ceil(INICIO / 10) * 10; d <= FIN; d += 10) decadas.push(d);

/** El hueco más largo sin hitos: la travesía del desierto. */
let hueco = { desde: 0, hasta: 0, largo: 0 };
for (let i = 1; i < anios.length; i++) {
  const l = anios[i] - anios[i - 1];
  if (l > hueco.largo) hueco = { desde: anios[i - 1], hasta: anios[i], largo: l };
}
---

<figure class="axis">
  <figcaption class="axis__intro">
    Su vida en una línea, de {INICIO} a {FIN}. Pulsa cualquier marca para ir a ese momento.
  </figcaption>

  <div class="axis__track">
    <span class="axis__line" aria-hidden="true"></span>

    {
      hueco.largo > 15 && (
        <span
          class="axis__gap"
          style={`left:${pos(hueco.desde)}%; width:${pos(hueco.hasta) - pos(hueco.desde)}%;`}
          title={`${hueco.largo} años sin hitos documentados: de ${hueco.desde} a ${hueco.hasta}`}
          aria-hidden="true"
        />
      )
    }

    <ol class="axis__marks">
      {
        hitos.map((h) => (
          <li class="axis__mark" style={`left:${pos(h.data.year as number)}%;`}>
            <a href={`#hito-${h.id}`} title={`${h.data.year} — ${h.data.title}`}>
              <span class="axis__dot" data-era={h.data.era} />
              <span class="axis__label">{h.data.title}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <ul class="axis__decades" aria-hidden="true">
      {
        decadas.map((d) => (
          <li style={`left:${pos(d)}%;`}>
            <span class="axis__tick" />
            <span class="axis__year">{d}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {
    hueco.largo > 15 && (
      <p class="axis__nota">
        El tramo apagado son los {hueco.largo} años entre {hueco.desde} y {hueco.hasta} en los
        que siguió bailando cada noche sin que casi nadie de fuera lo llamara.
      </p>
    )
  }
</figure>

<style>
  .axis {
    margin: 0 0 var(--space-xl);
  }

  .axis__intro {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .axis__track {
    position: relative;
    height: 5.5rem;
    padding-top: 2.4rem;
  }

  .axis__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 2.4rem;
    height: 1px;
    background: var(--color-border-strong);
  }

  /* El vacío largo se marca en lugar de disimularse: también cuenta algo. */
  .axis__gap {
    position: absolute;
    top: 2.15rem;
    height: 3px;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-paper) 22%, transparent) 0 3px,
      transparent 3px 8px
    );
  }

  .axis__marks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .axis__mark {
    position: absolute;
    top: 2.4rem;
    transform: translate(-50%, -50%);
  }

  .axis__mark a {
    display: block;
    padding: 0.55rem;
    line-height: 0;
  }

  .axis__dot {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    transition: transform var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .axis__dot[data-era='Homenaje'],
  .axis__dot[data-era='Reconocimiento'] {
    background: var(--color-wine);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .axis__mark a:hover .axis__dot,
  .axis__mark a:focus-visible .axis__dot {
    transform: scale(1.7);
  }

  /* El título solo aparece al apuntar: doce rótulos a la vez serían ilegibles. */
  .axis__label {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: var(--step--1);
    line-height: 1.2;
    color: var(--color-ivory);
    background: var(--color-charcoal);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.3em 0.6em;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-standard);
    max-width: 16rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .axis__mark a:hover .axis__label,
  .axis__mark a:focus-visible .axis__label {
    opacity: 1;
  }

  .axis__decades {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .axis__decades li {
    position: absolute;
    top: 2.4rem;
    transform: translateX(-50%);
    text-align: center;
  }

  .axis__tick {
    display: block;
    width: 1px;
    height: 6px;
    margin: 0 auto;
    background: var(--color-border-strong);
  }

  .axis__year {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .axis__nota {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    max-width: 46ch;
    margin: 0;
  }

  /* En pantalla estrecha el eje se queda corto: se deja desplazar. */
  @media (max-width: 40rem) {
    .axis {
      overflow-x: auto;
      padding-bottom: var(--space-2xs);
    }

    .axis__track {
      min-width: 34rem;
    }

    .axis__nota {
      min-width: 0;
    }
  }
</style>
