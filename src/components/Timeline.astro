---
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import VerifyBadge from './VerifyBadge.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;

const entries = await getCollection('timeline');
entries.sort((a, b) => a.data.order - b.data.order);

/**
 * Las fechas exactas se guardan en ISO para poder ordenarlas, pero en la
 * cronología se leen escritas en largo.
 */
const dateFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const withPlaces = await Promise.all(
  entries.map(async (entry) => {
    const place = entry.data.placeRef ? await getEntry(entry.data.placeRef) : null;

    // Fotografías del archivo que ilustran este hito.
    const media = (
      await Promise.all(entry.data.mediaRefs.map((ref) => getEntry(ref)))
    ).filter((m): m is NonNullable<typeof m> => Boolean(m?.data.image));

    const images = await Promise.all(
      media.map(async (item) => {
        const thumb = await getImage({
          src: item.data.image!,
          width: 560,
          format: 'webp',
          quality: 72,
        });
        const full = await getImage({
          src: item.data.image!,
          width: Math.min(item.data.image!.width, 1800),
          format: 'webp',
          quality: 82,
        });
        return {
          thumb: thumb.src,
          full: full.src,
          alt: item.data.alt ?? item.data.title,
          title: item.data.title,
          credit: item.data.credit ?? '',
          focal: item.data.focal,
        };
      }),
    );

    // El cuerpo de la ficha amplía el resumen; no todos los hitos lo tienen.
    const { Content } = await render(entry);
    const dateLabel = entry.data.dateExact
      ? dateFormatter.format(new Date(`${entry.data.dateExact}T00:00:00`))
      : (entry.data.dateApprox ?? entry.data.era);

    return { entry, place, images, Content, dateLabel };
  }),
);

const eras = [...new Set(entries.map((entry) => entry.data.era))];
---

<div class="timeline" data-timeline>
  <div class="timeline__filters" role="group" aria-label={locale === 'es' ? 'Filtrar por etapa' : 'Filter by era'}>
    <button class="timeline__filter is-active" data-era="all" type="button">
      {locale === 'es' ? 'Todas las etapas' : 'All eras'}
    </button>
    {
      eras.map((era) => (
        <button class="timeline__filter" data-era={era} type="button">
          {era}
        </button>
      ))
    }
  </div>

  <ol class="timeline__list">
    {
      withPlaces.map(({ entry, place, images, Content, dateLabel }) => (
        <li class="timeline__item" id={`hito-${entry.id}`} data-era={entry.data.era}>
          <details open={false}>
            <summary>
              <span class="timeline__date">{dateLabel}</span>
              <span class="timeline__title">{entry.data.title}</span>
              {images.length > 0 && (
                <span class="timeline__has-photo" aria-label="Con fotografía del archivo">
                  ◉
                </span>
              )}
            </summary>
            <div class="timeline__detail">
              <p>{entry.data.summary}</p>
              <div class="timeline__body">
                <Content />
              </div>
              {place && <p class="timeline__place">📍 {place.data.name}</p>}
              <VerifyBadge level={entry.data.verification} locale={locale} />

              {images.length > 0 && (
                <div class="timeline__gallery">
                  {images.map((img) => (
                    <button
                      class="timeline__photo"
                      type="button"
                      style={`--focal:${img.focal};`}
                      data-lightbox-item
                      data-full={img.full}
                      data-alt={img.alt}
                      data-caption={img.title}
                      data-meta={img.credit}
                    >
                      <img src={img.thumb} alt={img.alt} loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</div>

<script>
  const root = document.querySelector('[data-timeline]');
  const buttons = root?.querySelectorAll<HTMLButtonElement>('.timeline__filter');
  const items = root?.querySelectorAll<HTMLLIElement>('.timeline__item');

  // Si se llega desde el eje visual (#hito-xxx), ese hito se abre solo.
  function abrirDesdeHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id.startsWith('hito-')) return;
    const item = document.getElementById(id);
    const det = item?.querySelector('details');
    if (!det) return;
    det.open = true;
    item?.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
  window.addEventListener('hashchange', abrirDesdeHash);
  abrirDesdeHash();

  buttons?.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      button.classList.add('is-active');
      const era = button.dataset.era;
      items?.forEach((item) => {
        const show = era === 'all' || item.dataset.era === era;
        item.hidden = !show;
      });
    });
  });
</script>

<style>
  .timeline__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-bottom: var(--space-lg);
  }
  .timeline__filter {
    font-size: var(--step--1);
    padding: 0.4em 0.9em;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .timeline__filter.is-active,
  .timeline__filter:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }
  .timeline__item {
    padding: 0 0 var(--space-md) var(--space-md);
    position: relative;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: -0.4rem;
    top: 0.5rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .timeline__item summary {
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: baseline;
  }
  .timeline__date {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    min-width: 8rem;
  }
  .timeline__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-text);
  }
  .timeline__detail {
    margin-top: var(--space-2xs);
    padding-left: calc(8rem + var(--space-xs));
    color: var(--color-text-soft);
  }
  .timeline__place {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .timeline__body {
    max-width: 62ch;
  }

  .timeline__body :global(p),
  .timeline__body :global(li) {
    font-size: var(--step--1);
  }

  .timeline__body :global(ul) {
    padding-left: 1.1em;
  }

  .timeline__has-photo {
    color: var(--color-accent);
    font-size: 0.6em;
    opacity: 0.8;
  }

  .timeline__gallery {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-xs);
  }

  .timeline__photo {
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-charcoal) 80%, black);
    overflow: hidden;
    cursor: zoom-in;
    line-height: 0;
    width: 9rem;
  }

  .timeline__photo:hover {
    border-color: var(--color-accent);
  }

  .timeline__photo img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: var(--focal, center);
  }
  @media (max-width: 40rem) {
    .timeline__detail {
      padding-left: 0;
    }
  }
</style>
