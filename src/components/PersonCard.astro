---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import VerifyBadge from './VerifyBadge.astro';
import { localizedPath, type Locale } from '../lib/i18n';

interface Props {
  person: CollectionEntry<'people'>;
  locale?: Locale;
}

const { person, locale = 'es' } = Astro.props;

/**
 * El retrato sale casi siempre de una fotografía del archivo en la que aparecen
 * juntos: por eso se recorta con un foco propio en cada ficha.
 */
const portrait = person.data.portrait
  ? await getImage({ src: person.data.portrait, width: 560, format: 'webp', quality: 74 })
  : null;
---

<a class="card person-card" href={`${localizedPath('/personas', locale)}/${person.id}`}>
  {
    portrait ? (
      <span class="person-card__media">
        <img
          src={portrait.src}
          alt=""
          width="560"
          height="560"
          loading="lazy"
          decoding="async"
          style={`object-position:${person.data.focal};`}
        />
      </span>
    ) : (
      <span class="person-card__media person-card__media--empty" aria-hidden="true">
        <span>{person.data.name.charAt(0)}</span>
      </span>
    )
  }
  <span class="person-card__body">
    <h3>{person.data.name}</h3>
    <p class="person-card__role">{person.data.role}</p>
    <p class="person-card__relation">{person.data.relationToCarrete}</p>
    <VerifyBadge level={person.data.verification} locale={locale} />
  </span>
</a>

<style>
  .person-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    padding: var(--space-sm);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .person-card:hover,
  .person-card:focus-visible {
    border-color: var(--color-accent);
  }

  .person-card__media {
    flex: 0 0 auto;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-charcoal);
    border: 1px solid var(--color-border);
  }

  .person-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.6) contrast(1.05);
    transition: filter var(--duration-base) var(--ease-standard);
  }

  .person-card:hover .person-card__media img,
  .person-card:focus-visible .person-card__media img {
    filter: saturate(1) contrast(1);
  }

  /* Sin retrato todavía: inicial en lugar de un hueco vacío. */
  .person-card__media--empty {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  /* min-width:0 permite que el hijo de un flex se encoja; sin él, la insignia
     de verificación empujaba el contenido fuera de la tarjeta. */
  .person-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3xs);
    min-width: 0;
    flex: 1 1 auto;
  }

  /* La insignia es lo que desbordaba: se deja envolver y no forzar el ancho. */
  .person-card__body :global(.verify-badge) {
    max-width: 100%;
    white-space: normal;
    text-align: left;
  }

  .person-card h3,
  .person-card__role,
  .person-card__relation {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .person-card h3 {
    font-size: var(--step-1);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .person-card__role {
    color: var(--color-accent);
    font-size: var(--step--1);
    margin: 0;
  }

  .person-card__relation {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    margin: 0 0 var(--space-3xs);
  }
</style>
