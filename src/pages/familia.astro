---
import RoomLayout from '../layouts/RoomLayout.astro';
import StoryContent from '../components/StoryContent.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('stories', 'familia');
if (!entry) throw new Error('Falta el contenido de familia');
---

<RoomLayout slug="/familia" eyebrow="La familia y el hombre" title={entry.data.title} summary={entry.data.summary}>
  <StoryContent entry={entry} />
</RoomLayout>
