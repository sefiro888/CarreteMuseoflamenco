---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sala no encontrada" noIndex>
  <section class="section container prose">
    <p class="eyebrow">Error 404</p>
    <h1>Esta sala aún no existe</h1>
    <p>
      El pasillo que buscabas no lleva a ninguna sala del museo, o todavía no ha sido construida.
      Vuelve a la portada o visita el índice completo de salas.
    </p>
    <p>
      <a class="btn btn-primary" href="/">Volver a la portada</a>
      <a class="btn" href="/salas">Ver todas las salas</a>
    </p>
  </section>
</BaseLayout>
