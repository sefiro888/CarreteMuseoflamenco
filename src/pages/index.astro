---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { rooms } from '../lib/rooms';
import { getRoomImage } from '../lib/room-images';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import EmbedVideo from '../components/EmbedVideo.astro';

/**
 * Las cifras del archivo se cuentan, no se escriben a mano: si mañana entran
 * treinta fotos más, la portada lo dice sola.
 */
const media = (await getCollection('media')).filter((m) => m.data.status === 'published');
const cifras = [
  { n: media.filter((m) => m.data.type === 'photo' && m.data.image).length, label: 'fotografías del archivo' },
  { n: media.filter((m) => m.data.type === 'press').length, label: 'recortes de prensa' },
  { n: (await getCollection('places')).length, label: 'lugares en el mapa' },
  { n: (await getCollection('timeline')).length, label: 'hitos de su vida' },
];

const trailer = (await getCollection('videos')).find((v) => v.data.featured && v.data.kind === 'documental');

const teaser = await Promise.all(
  rooms.slice(1, 5).map(async (room) => {
    const art = getRoomImage(room.slug);
    // Las tarjetas van a un tercio de ancho: no hace falta servir el original.
    const thumb = art ? await getImage({ src: art.image, width: 720, format: 'webp', quality: 74 }) : null;
    return { room, art, thumb };
  }),
);
---

<BaseLayout title="Carrete de Málaga · Al compás de una vida">
  <Hero locale="es" />

  <section class="section container">
    <p class="eyebrow">El museo</p>
    <h2>Un archivo vivo, no una biografía cerrada</h2>
    <div class="prose">
      <p>
        José Losada Santiago, «Carrete de Málaga», es un bailaor flamenco ligado a Málaga y
        Torremolinos, conocido también como «el Fred Astaire gitano». Este museo digital reúne su
        biografía, su archivo y su voz, tal y como él mismo la cuenta: con gracia, con memoria y,
        a veces, con más de una versión de los hechos.
      </p>
      <p>
        Cada sala distingue con cuidado entre lo documentado, lo que Carrete recuerda y lo que
        todavía está por confirmar. Es un proyecto impulsado por su hijo, Bernardo Losada, como
        homenaje en vida, y está pensado para crecer durante años a medida que se incorpore el
        archivo familiar real: fotografías, vídeos, documentos y testimonios.
      </p>
    </div>
  </section>

  <!-- Su voz, en grande y sin adornos. La frase con la que cierra el libro. -->
  <section class="quote-hero">
    <div class="container">
      <blockquote>
        <p>Seguiré bailando hasta que se termine el carrete y no haya más hilo.</p>
        <footer>
          <cite>Carrete de Málaga</cite>
          <span class="quote-hero__src">Al compás de la vida, 2010</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <section class="section container">
    <ul class="figures">
      {
        cifras.map((c) => (
          <li class="figures__item">
            <span class="figures__n">{c.n}</span>
            <span class="figures__label">{c.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    trailer && (
      <section class="section container film">
        <div class="film__text">
          <p class="eyebrow">La película de su vida</p>
          <h2>{trailer.data.title}</h2>
          <p>{trailer.data.summary}</p>
          <p>
            <a class="btn" href={url('/videos')}>Ver todos los vídeos →</a>
          </p>
        </div>
        <div class="film__player">
          <EmbedVideo
            platform={trailer.data.platform}
            videoId={trailer.data.videoId}
            title={trailer.data.title}
            poster={trailer.data.poster}
            credit={trailer.data.credit}
            durationSeconds={trailer.data.durationSeconds}
          />
        </div>
      </section>
    )
  }

  <section class="section section--tight container">
    <p class="eyebrow">Empieza a recorrer el museo</p>
    <div class="card-grid">
      {
        teaser.map(({ room, art, thumb }) => (
          <a class="card teaser-card" href={url(room.slug)}>
            {thumb && (
              <span class="teaser-card__media">
                <img
                  src={thumb.src}
                  alt=""
                  width="720"
                  height="480"
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${art?.focal ?? 'center'};`}
                />
              </span>
            )}
            <span class="teaser-card__body">
              <h3>{room.title.es}</h3>
              <p>{room.summary.es}</p>
            </span>
          </a>
        ))
      }
    </div>
    <p style="margin-top: var(--space-lg);">
      <a class="btn" href={url("/salas")}>Ver el plano completo del museo (19 salas)</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* Las cifras del archivo, en display grande: dicen de un vistazo que aquí
     hay mucho detrás, sin tener que leerlo. */
  .figures {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    text-align: center;
  }

  .figures__n {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .figures__label {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .film {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .film {
      grid-template-columns: 1fr 1.15fr;
    }
  }

  .film__text p {
    color: var(--color-text-soft);
    max-width: 40ch;
  }

  /* La cita rompe el ritmo de la página: fondo distinto, tipografía de display
     y mucho aire. Es lo único que se lee a este tamaño en toda la portada. */
  .quote-hero {
    background: var(--color-charcoal);
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-2xl);
    margin-block: var(--space-xl);
  }

  .quote-hero blockquote {
    margin: 0;
    max-width: 34ch;
  }

  .quote-hero p {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--color-paper);
    margin: 0 0 var(--space-md);
    text-wrap: balance;
  }

  .quote-hero p::before {
    content: '«';
    color: var(--color-accent);
  }

  .quote-hero p::after {
    content: '»';
    color: var(--color-accent);
  }

  .quote-hero footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .quote-hero cite {
    font-style: normal;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--step--1);
  }

  .quote-hero__src {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  /* La tarjeta pasa a ser una fotografía con su texto debajo: el padding lo
     pone el cuerpo, no la tarjeta, para que la imagen llegue a los bordes. */
  .teaser-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  .teaser-card:hover,
  .teaser-card:focus-visible {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .teaser-card__media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .teaser-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Arranca desaturada y toma color al acercarse: el archivo es antiguo,
       pero el museo no es un álbum muerto. */
    filter: saturate(0.55) contrast(1.05);
    transition: transform var(--duration-slow) var(--ease-standard),
      filter var(--duration-base) var(--ease-standard);
  }

  .teaser-card:hover .teaser-card__media img,
  .teaser-card:focus-visible .teaser-card__media img {
    transform: scale(1.05);
    filter: saturate(1) contrast(1);
  }

  .teaser-card__body {
    display: block;
    padding: var(--space-sm) var(--space-md) var(--space-md);
  }

  .teaser-card h3 {
    color: var(--color-text);
    margin-top: 0;
  }

  .teaser-card p {
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser-card:hover,
    .teaser-card:focus-visible {
      transform: none;
    }
    .teaser-card:hover .teaser-card__media img {
      transform: none;
    }
  }
</style>
