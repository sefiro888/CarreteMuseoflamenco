---
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerifyBadge from '../../components/VerifyBadge.astro';
import SourceList from '../../components/SourceList.astro';
import MediaGrid from '../../components/MediaGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { prepareMedia, byDate } from '../../lib/media';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { id: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await render(person);

const portrait = person.data.portrait
  ? await getImage({ src: person.data.portrait, width: 900, format: 'webp', quality: 78 })
  : null;

const testimonials = (await getCollection('testimonials')).filter(
  (item) => item.data.personRef?.id === person.id,
);

// Piezas del archivo en las que aparece esta persona.
const related = (await getCollection('media'))
  .filter(
    (item) =>
      item.data.status === 'published' &&
      item.data.image &&
      item.data.peopleRefs.some((ref) => ref.id === person.id),
  )
  .sort(byDate);
const relatedItems = await prepareMedia(related);
---

<BaseLayout title={person.data.name} description={person.data.summary}>
  <section class="section container prose">
    <p class="eyebrow">{person.data.role}</p>
    <h1>{person.data.name}</h1>

    {
      portrait && (
        <figure class="person-hero">
          <img
            src={portrait.src}
            alt={`Detalle de una fotografía del archivo en la que aparece ${person.data.name}.`}
            width="900"
            height="600"
            style={`object-position:${person.data.focal};`}
          />
          {person.data.photoCredit && (
            <figcaption>{person.data.photoCredit}</figcaption>
          )}
        </figure>
      )
    }
    <p><VerifyBadge level={person.data.verification} /></p>
    <p>{person.data.summary}</p>
    <p><strong>Relación con Carrete:</strong> {person.data.relationToCarrete}</p>

    <Content />

    {
      testimonials.length > 0 && (
        <>
          <h2>Testimonios</h2>
          {testimonials.map((testimonial) => (
            <blockquote class="quote">
              <p>«{testimonial.data.quote}»</p>
              {testimonial.data.context && (
                <figcaption class="quote-cite">{testimonial.data.context}</figcaption>
              )}
              <VerifyBadge level={testimonial.data.verification} />
            </blockquote>
          ))}
        </>
      )
    }

    <SourceList sourceRefs={person.data.sourceRefs} />
  </section>

  {
    relatedItems.length > 0 && (
      <section class="section--tight container">
        <h2>En el archivo</h2>
        <p class="prose">
          {relatedItems.length === 1
            ? 'Una pieza del archivo familiar documenta su relación con Carrete.'
            : `${relatedItems.length} piezas del archivo familiar documentan su relación con Carrete.`}
        </p>
        <MediaGrid items={relatedItems} />
      </section>
    )
  }

  <section class="section--tight container">
    <p><a href={url("/maestros")}>← Volver a Carrete y los maestros</a></p>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .person-hero {
    margin: 0 0 var(--space-md);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .person-hero img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .person-hero figcaption {
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    background: var(--color-bg-raised);
  }
</style>
