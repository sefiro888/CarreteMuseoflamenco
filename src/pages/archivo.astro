---
import RoomLayout from '../layouts/RoomLayout.astro';
import MediaGrid from '../components/MediaGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { getPublishedMedia, prepareMedia, byDate, TYPE_LABELS } from '../lib/media';

const published = (await getPublishedMedia()).sort(byDate);
const items = await prepareMedia(published);

// Piezas todavía sin material: se siguen listando para que el archivo sea
// honesto sobre lo que falta por incorporar.
const pending = (await getCollection('media')).filter(
  (item) => !item.data.image && item.data.status !== 'published',
);

const types = [...new Set(published.map((i) => i.data.type))];
const decades = [...new Set(items.map((i) => i.decade).filter(Boolean))].sort() as string[];
---

<RoomLayout
  slug="/archivo"
  eyebrow="Archivo fotográfico y audiovisual"
  title="Archivo fotográfico y audiovisual"
  summary="El material que documenta su vida."
>
  <div class="prose">
    <p>
      Este archivo reúne <strong>{items.length} piezas</strong> cedidas por la familia Losada y
      por Paco Roji: fotografías desde 1953, carteles, programas de mano, postales y recortes de
      prensa. Puedes buscar por nombre, lugar o persona, y filtrar por década y tipo de material.
      Pulsa cualquier pieza para verla ampliada.
    </p>
    <p>
      Cada ficha conserva el crédito del fotógrafo cuando se conoce. Buena parte del material
      antiguo no tiene autoría identificada: aparece acreditado al archivo familiar y queda
      pendiente de atribuir.
    </p>
  </div>

  <div class="archive-controls section--tight" data-archive>
    <div class="archive-search-row">
      <label class="archive-search-label" for="archive-search">Buscar en el archivo</label>
      <input
        id="archive-search"
        type="search"
        placeholder="Un nombre, un tablao, un año…"
        class="archive-search"
        data-archive-search
        autocomplete="off"
      />
    </div>

    <div class="archive-filters" role="group" aria-label="Filtrar por tipo de material">
      <span class="archive-filters__label">Tipo</span>
      <button class="timeline__filter is-active" data-filter-type="all" type="button">Todo</button>
      {
        types.map((type) => (
          <button class="timeline__filter" data-filter-type={type} type="button">
            {TYPE_LABELS[type] ?? type}
          </button>
        ))
      }
    </div>

    <div class="archive-filters" role="group" aria-label="Filtrar por década">
      <span class="archive-filters__label">Década</span>
      <button class="timeline__filter is-active" data-filter-decade="all" type="button">Todas</button>
      {
        decades.map((d) => (
          <button class="timeline__filter" data-filter-decade={d} type="button">
            {d}s
          </button>
        ))
      }
    </div>

    <p class="archive-count" role="status" aria-live="polite" data-archive-count></p>

    <MediaGrid items={items} />

    <p class="archive-empty" data-archive-empty hidden>
      No hay piezas que coincidan con esa búsqueda. Prueba con otro nombre o quita los filtros.
    </p>
  </div>

  {
    pending.length > 0 && (
      <div class="section--tight">
        <h2>Pendiente de incorporar</h2>
        <p class="prose">
          Material que el archivo tiene identificado pero todavía no ha podido digitalizar o
          publicar, por estar pendiente de permisos o de localizar el original.
        </p>
        <ul class="pending-list">
          {pending.map((item) => (
            <li>
              <strong>{item.data.title}</strong>
              {item.data.rightsNote && <span> — {item.data.rightsNote}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <Lightbox />
</RoomLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('[data-archive-search]');
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-media-list] > li'));
    const emptyMessage = root.querySelector<HTMLElement>('[data-archive-empty]');
    const countLabel = root.querySelector<HTMLElement>('[data-archive-count]');

    let activeType = 'all';
    let activeDecade = 'all';

    function applyFilters() {
      const query = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const item of items) {
        const matchesType = activeType === 'all' || item.dataset.type === activeType;
        const matchesDecade = activeDecade === 'all' || item.dataset.decade === activeDecade;
        const matchesQuery = !query || (item.dataset.search ?? '').includes(query);
        const show = matchesType && matchesDecade && matchesQuery;
        item.hidden = !show;
        if (show) visible += 1;
      }
      if (emptyMessage) emptyMessage.hidden = visible !== 0;
      if (countLabel) {
        countLabel.textContent =
          visible === items.length
            ? `${items.length} piezas en el archivo`
            : `${visible} de ${items.length} piezas`;
      }
    }

    /**
     * Los botones de filtro llevan `data-filter-*` propio: las tarjetas del
     * archivo también tienen `data-type` y `data-decade`, y un selector más
     * amplio las convertiría a todas en botones de filtro.
     */
    function wireGroup(attr: 'type' | 'decade') {
      const selector = attr === 'type' ? '[data-filter-type]' : '[data-filter-decade]';
      const buttons = root!.querySelectorAll<HTMLButtonElement>(selector);
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('is-active'));
          button.classList.add('is-active');
          const value =
            (attr === 'type' ? button.dataset.filterType : button.dataset.filterDecade) ?? 'all';
          if (attr === 'type') activeType = value;
          else activeDecade = value;
          applyFilters();
        });
      });
    }

    wireGroup('type');
    wireGroup('decade');
    search?.addEventListener('input', applyFilters);
    applyFilters();
  }
</script>

<style>
  .archive-search-label {
    display: block;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xs);
  }

  .archive-search {
    width: 100%;
    max-width: 30rem;
    padding: 0.7em 1em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-raised);
    color: var(--color-text);
  }

  .archive-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }

  .archive-filters__label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-right: var(--space-2xs);
  }

  .archive-count {
    margin: var(--space-md) 0 var(--space-sm);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .archive-empty {
    margin-top: var(--space-lg);
    color: var(--color-text-soft);
  }

  .pending-list {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    max-width: var(--prose-max);
  }

  .pending-list li {
    margin-bottom: var(--space-2xs);
  }
</style>
