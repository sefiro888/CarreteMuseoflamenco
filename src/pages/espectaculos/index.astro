---
import RoomLayout from '../../layouts/RoomLayout.astro';
import VerifyBadge from '../../components/VerifyBadge.astro';
import { getCollection } from 'astro:content';

const performances = await getCollection('performances');

const today = new Date().toISOString().slice(0, 10);
const upcoming = performances
  .filter((show) => show.data.upcomingDate && show.data.upcomingDate >= today)
  .sort((a, b) => (a.data.upcomingDate ?? '').localeCompare(b.data.upcomingDate ?? ''));

const dateFormatter = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<RoomLayout
  slug="/espectaculos"
  eyebrow="Espectáculos y obras"
  title="Espectáculos y obras"
  summary="Fichas de sus espectáculos principales."
>
  <div class="card-grid">
    {
      performances.map((show) => (
        <a class="card" style="text-decoration:none; color:inherit;" href={`/espectaculos/${show.id}`}>
          <h3>{show.data.title}</h3>
          {show.data.venue && <p class="eyebrow">{show.data.venue}</p>}
          <p>{show.data.description}</p>
          <VerifyBadge level={show.data.verification} />
        </a>
      ))
    }
  </div>

  <div class="section--tight">
    <h2>Agenda de próximas actuaciones</h2>
    {
      upcoming.length > 0 ? (
        <ul class="agenda-list">
          {upcoming.map((show) => (
            <li class="agenda-list__item">
              <span class="agenda-list__date">
                {dateFormatter.format(new Date(`${show.data.upcomingDate}T00:00:00`))}
              </span>
              <span class="agenda-list__title">{show.data.title}</span>
              {show.data.venue && <span class="agenda-list__venue">{show.data.venue}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="prose">
          No hay actuaciones futuras anunciadas todavía. En cuanto la familia o Paco Roji confirmen
          una fecha, aparecerá aquí automáticamente.
        </p>
      )
    }
  </div>
</RoomLayout>

<style>
  .agenda-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .agenda-list__item {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: baseline;
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
  }
  .agenda-list__date {
    font-family: var(--font-display);
    color: var(--color-accent);
    min-width: 12rem;
  }
  .agenda-list__title {
    font-weight: 600;
  }
  .agenda-list__venue {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
