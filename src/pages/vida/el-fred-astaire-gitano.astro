---
import RoomLayout from '../../layouts/RoomLayout.astro';
import StoryContent from '../../components/StoryContent.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('stories', 'el-fred-astaire-gitano');
if (!entry) throw new Error('Falta el contenido de el-fred-astaire-gitano');
---

<RoomLayout
  slug="/vida/el-fred-astaire-gitano"
  eyebrow="La vida — 5 de 5"
  title={entry.data.title}
  summary={entry.data.summary}
>
  <StoryContent entry={entry} />
</RoomLayout>
