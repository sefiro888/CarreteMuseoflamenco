---
import { url } from '../lib/url';
import RoomLayout from '../layouts/RoomLayout.astro';
import VerifyBadge from '../components/VerifyBadge.astro';
import SourceList from '../components/SourceList.astro';
import { getCollection, getEntries, render } from 'astro:content';
import MediaGrid from '../components/MediaGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { prepareMedia } from '../lib/media';

const awards = await getCollection('awards');

/**
 * Los premios se ordenan del más reciente al más antiguo; los que todavía no
 * tienen año fijado quedan al final, en vez de colarse arriba por azar.
 */
const entries = await Promise.all(
  awards
    .sort((a, b) => (b.data.year ?? '').localeCompare(a.data.year ?? ''))
    .map(async (award) => {
      const refs = award.data.mediaRefs.length ? await getEntries(award.data.mediaRefs) : [];
      const piezas = await prepareMedia(refs.filter((m) => m?.data.image));
      return { award, Content: (await render(award)).Content, piezas };
    }),
);
---

<RoomLayout
  slug="/premios"
  eyebrow="Premios y homenajes"
  title="Premios y homenajes"
  summary="El reconocimiento a una trayectoria."
>
  <div class="award-list">
    {
      entries.map(({ award, Content, piezas }) => (
        <article class="award">
          <header class="award__head">
            <h2>{award.data.title}</h2>
            <p class="eyebrow">
              {[award.data.grantor, award.data.year].filter(Boolean).join(' · ')}
            </p>
            <VerifyBadge level={award.data.verification} />
          </header>
          <p class="award__lede">{award.data.description}</p>
          <div class="prose">
            <Content />
          </div>
          {piezas.length > 0 && (
            <div class="award__media">
              <MediaGrid items={piezas} />
            </div>
          )}
          <SourceList sourceRefs={award.data.sourceRefs} />
        </article>
      ))
    }
  </div>

  <p class="section--tight">
    <a href={url("/estatua")}>Ver también: la estatua de Torremolinos →</a>
  </p>
  <Lightbox />
</RoomLayout>

<style>
  .award-list {
    display: grid;
    gap: var(--space-lg);
  }

  .award {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .award:first-child {
    border-top: none;
    padding-top: 0;
  }

  .award__head h2 {
    margin-bottom: var(--space-3xs);
  }

  .award__media {
    margin: var(--space-md) 0;
    max-width: 34rem;
  }

  .award__lede {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--color-paper);
    max-width: 60ch;
  }
</style>
