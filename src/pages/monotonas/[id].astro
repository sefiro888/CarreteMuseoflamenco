---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerifyBadge from '../../components/VerifyBadge.astro';
import SourceList from '../../components/SourceList.astro';
import ProvisionalNote from '../../components/ProvisionalNote.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';

export async function getStaticPaths() {
  const monotonas = await getCollection('monotonas');
  return monotonas.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const people = item.data.peopleRefs.length ? await getEntries(item.data.peopleRefs) : [];
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.summary}>
  <section class="section container prose">
    <p class="eyebrow">Monótona</p>
    <h1>{item.data.title}</h1>
    <p><VerifyBadge level={item.data.verification} /></p>

    {
      item.data.videoAvailable && item.data.videoUrl && item.data.poster ? (
        <VideoPlayer
          src={item.data.videoUrl}
          poster={item.data.poster}
          description={item.data.summary}
          credit={item.data.credit}
          durationSeconds={item.data.durationSeconds}
        />
      ) : (
        <ProvisionalNote>
          El vídeo de esta monótona todavía no se ha incorporado al archivo.
        </ProvisionalNote>
      )
    }

    <div class="monotona__body">
      <Content />
    </div>

    {
      item.data.transcript ? (
        <details open>
          <summary>Transcripción</summary>
          <p>{item.data.transcript}</p>
        </details>
      ) : (
        item.data.videoAvailable && (
          <p class="monotona__pending">
            Esta monótona todavía no tiene transcripción ni subtítulos. Hasta que existan, el
            museo no reproduce por escrito lo que Carrete dice en el vídeo.
          </p>
        )
      )
    }

    {
      item.data.translationEn && (
        <details>
          <summary>English translation</summary>
          <p>{item.data.translationEn}</p>
        </details>
      )
    }

    {
      people.length > 0 && (
        <>
          <h2>Personas relacionadas</h2>
          <ul>
            {people.map((person) => (
              <li>
                <a href={`/personas/${person.id}`}>{person.data.name}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <SourceList sourceRefs={item.data.sourceRefs} />
    <p><a href="/monotonas">← Volver a las monótonas</a></p>
  </section>
</BaseLayout>

<style>
  .monotona__body {
    margin-top: var(--space-lg);
  }

  .monotona__pending {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    border-left: 2px solid var(--color-border-strong);
    padding-left: var(--space-sm);
  }
</style>
