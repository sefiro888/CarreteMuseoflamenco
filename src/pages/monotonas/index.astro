---
import { url } from '../../lib/url';
import RoomLayout from '../../layouts/RoomLayout.astro';
import VerifyBadge from '../../components/VerifyBadge.astro';
import ProvisionalNote from '../../components/ProvisionalNote.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

const all = await getCollection('monotonas');
// Las que ya tienen grabación van primero: son el contenido real de la sala.
const monotonas = [...all].sort(
  (a, b) => Number(b.data.videoAvailable) - Number(a.data.videoAvailable),
);
const withVideo = monotonas.filter((m) => m.data.videoAvailable);

const posters = new Map<string, string>();
for (const item of monotonas) {
  if (item.data.poster) {
    const img = await getImage({ src: item.data.poster, width: 640, format: 'webp', quality: 72 });
    posters.set(item.id, img.src);
  }
}
---

<RoomLayout
  slug="/monotonas"
  eyebrow="Las monótonas de Carrete"
  title="Las monótonas de Carrete"
  summary="Sus anécdotas, contadas por él mismo."
>
  <div class="prose">
    <p>
      Carrete llama «monótonas» a sus anécdotas. No son un anexo curioso a su
      biografía: son una forma de contar el mundo tan personal como su manera de
      bailar. Cada monótona, cuando exista, incluirá vídeo, audio original,
      subtítulos literales, transcripción accesible y traducción al inglés sin
      sustituir su voz.
    </p>
  </div>

  {
    withVideo.length === 0 ? (
      <ProvisionalNote>
        Todavía no se ha incorporado ninguna grabación real. Las fichas siguientes son
        marcadores de posición que preparan la estructura del archivo.
      </ProvisionalNote>
    ) : (
      <ProvisionalNote>
        {withVideo.length === 1
          ? 'De momento hay una monótona grabada. Le falta la transcripción, los subtítulos y la traducción: el museo todavía no reproduce por escrito lo que cuenta.'
          : `De momento hay ${withVideo.length} monótonas grabadas, pendientes de transcripción y subtítulos.`}
      </ProvisionalNote>
    )
  }

  <div class="card-grid section--tight">
    {
      monotonas.map((item) => (
        <a class="card archive-piece" href={url(`/monotonas/${item.id}`)}>
          <div class="archive-piece__media">
            {posters.has(item.id) ? (
              <img src={posters.get(item.id)} alt="" loading="lazy" decoding="async" />
            ) : (
              <span>Vídeo pendiente de incorporar</span>
            )}
          </div>
          <h3 class="archive-piece__title">{item.data.title}</h3>
          <p class="archive-piece__meta">{item.data.dateApprox}</p>
          <VerifyBadge level={item.data.verification} />
        </a>
      ))
    }
  </div>

  <div class="section--tight prose">
    <h2>El diccionario de Carrete</h2>
    <p>
      Junto a las monótonas, este museo prepara un futuro «Diccionario de Carrete»:
      sus palabras, remates, expresiones y bendiciones propias. Todavía no existe
      contenido verificado para esta sección — se irá construyendo a partir de las
      grabaciones reales.
    </p>
  </div>
</RoomLayout>

<style>
  .archive-piece {
    text-decoration: none;
    color: inherit;
  }

  .archive-piece__media {
    padding: 0;
    overflow: hidden;
  }

  .archive-piece__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
