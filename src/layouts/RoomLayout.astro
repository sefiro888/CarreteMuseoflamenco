---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { getRoomNeighbors } from '../lib/rooms';
import { getRoomImage } from '../lib/room-images';
import { t, localizedPath, type Locale } from '../lib/i18n';
import { breadcrumbJsonLd } from '../lib/seo';

interface Props {
  slug: string;
  eyebrow?: string;
  title: string;
  summary?: string;
  description?: string;
  locale?: Locale;
  image?: string;
}

const { slug, eyebrow, title, summary, description, locale = 'es', image } = Astro.props;
const dict = t(locale);
const { prev, next } = getRoomNeighbors(slug);
const roomImage = getRoomImage(slug);

const breadcrumb = breadcrumbJsonLd([
  { name: locale === 'es' ? 'Inicio' : 'Home', url: new URL(localizedPath('/', locale), Astro.site).toString() },
  { name: title, url: new URL(localizedPath(slug, locale), Astro.site).toString() },
]);
---

<BaseLayout title={title} description={description ?? summary} locale={locale} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <article class="room">
    <header class="room__hero container">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {summary && <p class="room__summary">{summary}</p>}
    </header>

    {
      roomImage && (
        <figure class="room__figure">
          <div class="room__figure-frame" style={`--focal:${roomImage.focal ?? 'center'};`}>
            <Image
              src={roomImage.image}
              alt={roomImage.alt}
              widths={[640, 1024, 1600]}
              sizes="(max-width: 74rem) 100vw, 74rem"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption class="container">
            <span>{roomImage.caption}</span>
            <span class="room__figure-credit">{roomImage.credit}</span>
          </figcaption>
        </figure>
      )
    }

    <div class="container room__body">
      <slot />
    </div>

    <nav class="room__nav container" aria-label={locale === 'es' ? 'Navegación entre salas' : 'Room navigation'}>
      {
        prev && (
          <a class="room__nav-link room__nav-link--prev" href={localizedPath(prev.slug, locale)}>
            <span class="room__nav-label">{dict.previousRoom}</span>
            <span class="room__nav-title">{prev.title[locale]}</span>
          </a>
        )
      }
      {
        next && (
          <a class="room__nav-link room__nav-link--next" href={localizedPath(next.slug, locale)}>
            <span class="room__nav-label">{dict.nextRoom}</span>
            <span class="room__nav-title">{next.title[locale]}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .room__hero {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-lg);
    max-width: var(--prose-max);
  }
  .room__summary {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--color-paper);
    font-style: italic;
  }
  .room__figure {
    margin: 0 0 var(--space-xl);
  }

  .room__figure-frame {
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-charcoal) 80%, black);
  }

  .room__figure-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal, center);
  }

  .room__figure figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .room__figure-credit {
    color: color-mix(in srgb, var(--color-paper) 45%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
  }

  @media (max-width: 48rem) {
    .room__figure-frame {
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }
  }

  .room__body {
    padding-bottom: var(--space-2xl);
  }
  .room__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }
  .room__nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    text-decoration: none;
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .room__nav-link:hover {
    border-color: var(--color-accent);
  }
  .room__nav-link--next {
    text-align: right;
    grid-column: 2;
  }
  .room__nav-label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .room__nav-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-text);
  }
  @media (max-width: 40rem) {
    .room__nav {
      grid-template-columns: 1fr;
    }
    .room__nav-link--next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
